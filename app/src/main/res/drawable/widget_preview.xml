<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 角丸カード背景 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="270"
                android:startColor="#4F46E5"
                android:endColor="#6D28D9" />
        </shape>
    </item>
    <!-- バッジ -->
    <item
        android:width="64dp"
        android:height="10dp"
        android:gravity="top|start"
        android:left="18dp"
        android:top="20dp">
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <solid android:color="#C7D2FE" />
        </shape>
    </item>
    <!-- 問題文 1行目 -->
    <item
        android:width="150dp"
        android:height="12dp"
        android:gravity="top|start"
        android:left="18dp"
        android:top="44dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#B3FFFFFF" />
        </shape>
    </item>
    <!-- 問題文 2行目 -->
