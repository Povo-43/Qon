        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#80FFFFFF" />
        </shape>
    </item>
    <!-- 選択肢 A -->
    <item
        android:height="26dp"
        android:gravity="top"
        android:left="18dp"
        android:right="18dp"
