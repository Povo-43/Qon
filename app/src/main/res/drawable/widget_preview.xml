            <corners android:radius="12dp" />
            <solid android:color="#26FFFFFF" />
        </shape>
    </item>
    <!-- 選択肢 C -->
    <item
        android:height="26dp"
        android:gravity="top"
        android:left="18dp"
        android:right="18dp"
        android:top="156dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#26FFFFFF" />
        </shape>
    </item>
    <!-- 選択肢 D -->
    <item
        android:height="26dp"
