<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Widget Option Button Style -->
    <style name="Widget.App.Button.Option" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/md_sys_color_on_surface</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/md_sys_color_outline</item>
        <item name="rippleColor">@color/md_sys_color_primary_container</item>
    </style>

    <!-- Correct Answer Button Style -->
    <style name="Widget.App.Button.Option.Correct" parent="Widget.App.Button.Option">
        <item name="android:backgroundTint">@color/correct_light</item>
        <item name="strokeColor">@color/correct_green</item>
        <item name="android:textColor">@color/correct_green</item>
    </style>

    <!-- Incorrect Answer Button Style -->
    <style name="Widget.App.Button.Option.Incorrect" parent="Widget.App.Button.Option">
        <item name="android:backgroundTint">@color/incorrect_light</item>
        <item name="strokeColor">@color/incorrect_red</item>
        <item name="android:textColor">@color/incorrect_red</item>
    </style>

    <!-- Disabled Button Style -->
    <style name="Widget.App.Button.Option.Disabled" parent="Widget.App.Button.Option">
        <item name="android:alpha">0.6</item>
    </style>
</resources>
